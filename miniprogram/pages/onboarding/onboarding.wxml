<privacy-popup id="pp" />
<view class="page">
  <view class="hero">
    <view class="date">选择你的生活方式</view>
    <view class="sub">选 1~3 个人格，帮你生成专属习惯 🎯</view>
  </view>
  <view class="card">
    <view class="card-title">第一步 · 人格大方向（已选 {{majorsCount}}/3）</view>
    <view style="display:flex;flex-wrap:wrap;">
      <view class="major {{selected[item.key]?'on':''}}" wx:for="{{MAJORS}}" wx:key="key" bindtap="toggleMajor" data-k="{{item.key}}">
        <view class="major-check" wx:if="{{selected[item.key]}}">✓</view>
        <view style="font-size:40rpx;">{{item.icon}}</view>
        <view style="font-weight:700;">{{item.name}}</view>
        <view class="muted" style="font-size:20rpx;margin-top:4rpx;">{{item.desc}}</view>
      </view>
    </view>
  </view>
  <view class="card" wx:if="{{subs.length > 0}}">
    <view class="card-title">第二步 · 细分兴趣（可多选）</view>
    <view style="display:flex;flex-wrap:wrap;">
      <view class="chip {{subSelected[item]?'on':''}}" wx:for="{{subs}}" wx:key="*this" bindtap="toggleSub" data-v="{{item}}">{{item}}</view>
    </view>
  </view>
  <button class="btn-primary" hover-class="btn-hover" bindtap="finish">✅ 完成，生成我的专属习惯</button>
  <view class="list-note" style="text-align:center;margin-top:8rpx;">以后随时可在「我的」里修改</view>
</view>
