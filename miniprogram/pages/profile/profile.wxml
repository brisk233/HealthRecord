<privacy-popup id="pp" />
<view class="page">
  <view class="card" wx:if="{{!loggedIn}}">
    <view class="card-title">🔐 微信登录</view>
    <button class="btn-primary" hover-class="btn-hover" bindtap="doLogin">微信一键登录</button>
    <view class="list-note">登录后头像、昵称与家庭数据跟随微信账号，换手机不丢失；未登录也可本地使用</view>
  </view>

  <block wx:if="{{loggedIn}}">

  <view class="card" style="padding:16rpx 20rpx;box-shadow:none;">
    <view style="display:flex;align-items:center;">
      <view style="position:relative;flex-shrink:0;">
        <button class="avatar-btn-m" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{myAvatarUrl}}" src="{{myAvatarUrl}}" class="avatar-img-m"/>
          <image wx:elif="{{myAvatar}}" src="{{myAvatar}}" class="avatar-img-m"/>
          <text wx:else class="avatar-placeholder">＋</text>
        </button>
        <view class="avatar-cam">📷</view>
      </view>
      <view style="flex:1;margin-left:8rpx;min-width:0;">
        <input class="nick-input-dark" type="nickname" placeholder="我的昵称" value="{{nickname}}" bindinput="onNickname" bindblur="onNicknameBlur"/>
        <view class="muted" style="margin-top:6rpx;font-size:22rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{{family ? '🏠 ' + (family.name || '我们的家') : '未加入家庭'}}</view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{showGuide}}">
    <view class="card-title">🎯 完善我的生活方式</view>
    <view class="list-note">选人格标签，生成你的专属习惯（1 分钟）</view>
    <button class="btn-primary" hover-class="btn-hover" bindtap="goOnboarding">开始选择 →</button>
  </view>
  <view class="card" wx:if="{{!family}}">
    <view class="card-title">🏠 建立小家庭</view>
    <button class="btn-primary" hover-class="btn-hover" bindtap="createFamily">✨ 创建家庭</button>
    <view class="list-note" style="margin-top:16rpx;">或输入 TA 的邀请码：</view>
    <input class="input" placeholder="6 位邀请码" value="{{joinCode}}" bindinput="onJoinCode"/>
    <picker range="{{relations}}" value="{{joinRelationIdx}}" bindchange="onRelation">
      <view class="input">与 TA 的关系：{{relations[joinRelationIdx]}}</view>
    </picker>
    <button class="btn-ghost" hover-class="btn-hover" bindtap="joinFamily">🔑 加入家庭</button>
  </view>

  <view class="card" wx:else>
    <view class="card-title" style="display:flex;align-items:center;justify-content:space-between;" bindtap="toggleFamily">
      <text wx:if="{{!editingName}}" class="family-name" catchtap="editName">🏠 {{family.name || '我们的家'}}</text>
      <input wx:else class="input" style="flex:1;margin:0;" placeholder="家庭名称（≤12字）" value="{{familyName}}" bindinput="onNameInput" bindblur="saveName" bindconfirm="saveName" focus="{{true}}" maxlength="12"/>
      <view style="display:flex;align-items:center;">
        <view style="padding:12rpx 4rpx 12rpx 16rpx;" catchtap="toggleFamily"><text class="muted">{{familyOpen ? '收起 ▴' : '成员' + family.members.length + ' · ▾'}}</text></view>
      </view>
    </view>
    <view class="panel" wx:if="{{familyOpen}}">
    <view class="row" wx:for="{{family.members}}" wx:key="openid">
      <view style="display:flex;align-items:center;">
        <image wx:if="{{item.avatarUrl && !item.avatarErr}}" src="{{item.avatarUrl}}" class="avatar-sm" mode="aspectFill" binderror="onAvatarError" data-idx="{{index}}"/>
        <text wx:else class="avatar-sm-ph">👤</text>
        <text>{{item.nickname}}<text class="muted" style="margin-left:8rpx;">{{item.gender==='female'?'她':'他'}}</text></text>
      </view>
      <text class="tag {{item.role==='creator'?'':'pink'}}">{{item.relation}}</text>
    </view>
    <picker range="{{relations}}" value="{{myRelationIdx}}" bindchange="onMyRelation">
      <view class="input">我与 TA 的关系备注：{{relations[myRelationIdx]}}</view>
    </picker>
    <block wx:if="{{myRole === 'creator'}}">
      <view class="row"><text>邀请码</text><text style="font-weight:800;font-size:40rpx;color:#2FB287;letter-spacing:4rpx;">{{family.code}}</text></view>
      <button class="btn-primary" hover-class="btn-hover" bindtap="copyCode">📋 复制邀请码</button>
      <button class="btn-ghost" hover-class="btn-hover" open-type="share">💌 微信邀请 TA</button>
    </block>
    <view wx:else class="list-note">🔒 邀请与改名由家庭创建者管理</view>
    <button class="btn-ghost" hover-class="btn-hover" style="color:#C23B3B;border-color:#C23B3B;" bindtap="leaveFamily">{{myRole === 'creator' ? '解散家庭' : '退出家庭'}}</button>
    </view>
  </view>

  <view class="card">
    <view class="card-title" style="display:flex;align-items:center;justify-content:space-between;" bindtap="toggleBase">
      <text>📋 我的基础数据</text>
      <text class="muted" style="margin:0;">{{baseOpen ? '收起 ▴' : (person.goal + ' · ' + person.height + 'cm/' + person.weight + 'kg · 蛋白' + protein + 'g ▾')}}</text>
    </view>
    <view class="panel" wx:if="{{baseOpen}}">
      <picker range="{{genders}}" value="{{genderIdx}}" bindchange="onGender">
        <view class="input">我是：{{genders[genderIdx]}}</view>
      </picker>
      <picker range="{{goals}}" value="{{goalIdx}}" bindchange="onGoal">
        <view class="input">🎯 目标：{{goals[goalIdx]}}</view>
      </picker>
      <input class="input" type="number" placeholder="身高 cm" value="{{form.height}}" bindinput="onHeight"/>
      <input class="input" type="number" placeholder="体重 kg" value="{{form.weight}}" bindinput="onWeight"/>
      <view class="row"><text>💪 每日蛋白质目标</text><text class="tag">{{protein}} g</text></view>
      <view class="row"><text>🔥 每日热量目标</text><text class="tag">{{calorie}} kcal</text></view>
      <view class="muted">BMI：{{bmi}}（18.5~24 为正常）</view>
      <button class="btn-primary" hover-class="btn-hover" bindtap="save">保存</button>
    </view>
  </view>

  <view class="card">
    <view class="card-title" style="display:flex;align-items:center;justify-content:space-between;" bindtap="toggleSuppCard">
      <text>💊 补剂打卡</text>
      <text class="muted" style="margin:0;">{{suppOpen ? '收起 ▴' : '共 ' + person.supps.length + ' 种 · ' + (person.suppEnabled !== false ? '今日页显示' : '已隐藏') + ' ▾'}}</text>
    </view>
    <view class="panel" wx:if="{{suppOpen}}">
      <view class="row">
        <text>在今日页显示补剂打卡</text>
        <switch checked="{{person.suppEnabled !== false}}" bindchange="onSuppEnabled" color="#2FB287"/>
      </view>
      <view class="row" wx:for="{{person.supps}}" wx:key="key">
        <view style="flex:1;"><text>{{item.name}} · {{item.dose}}</text><view class="muted">{{item.time}}</view></view>
        <view class="btn-x" hover-class="btn-hover" data-key="{{item.key}}" catchtap="delSupp">✕</view>
      </view>
      <view class="list-note">自定义补剂：</view>
      <input class="input" placeholder="名称，如：钙片" value="{{newSupp.name}}" bindinput="onNewSuppName"/>
      <input class="input" placeholder="剂量，如：1粒" value="{{newSupp.dose}}" bindinput="onNewSuppDose"/>
      <input class="input" placeholder="时间，如：随早餐" value="{{newSupp.time}}" bindinput="onNewSuppTime"/>
      <button class="btn-primary" hover-class="btn-hover" bindtap="addSupp">添加补剂</button>
      <view class="list-note">剂量以产品说明与医生建议为准，本工具只做提醒</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title" style="display:flex;align-items:center;justify-content:space-between;" bindtap="toggleHabitCard">
      <text>⭐ 我的习惯</text>
      <text class="muted" style="margin:0;">{{habitOpen ? '收起 ▴' : '共' + habitsCount + '个 ▾'}}</text>
    </view>
    <view class="panel" wx:if="{{habitOpen}}">
      <view class="row" wx:for="{{habits}}" wx:key="key">
        <text>{{item.icon}} {{item.name}} · {{item.freq}}</text>
        <view class="btn-x" hover-class="btn-hover" data-key="{{item.key}}" catchtap="delHabit">✕</view>
      </view>
      <view class="list-note">添加自定义习惯：</view>
      <input class="input" placeholder="名称，如：练字" value="{{newHabit.name}}" bindinput="onNewHabitName"/>
      <picker range="{{freqs}}" value="{{freqIdx}}" bindchange="onFreq">
        <view class="input">频率：{{freqs[freqIdx]}}</view>
      </picker>
      <button class="btn-primary" hover-class="btn-hover" bindtap="addHabit">➕ 添加习惯</button>
      <button class="btn-ghost" hover-class="btn-hover" bindtap="goOnboarding">🎯 重新选择生活方式</button>
      <button class="btn-ghost" hover-class="btn-hover" bindtap="reGenHabits">🎯 按标签更新习惯</button>
    </view>
  </view>

  <view class="card">
    <view class="card-title" style="display:flex;align-items:center;justify-content:space-between;" bindtap="toggleModCard">
      <text>🧩 功能模块</text>
      <text class="muted" style="margin:0;">{{modOpen ? '收起 ▴' : '已开 ' + modOnCount + '/3 ▾'}}</text>
    </view>
    <view class="panel" wx:if="{{modOpen}}">
      <view class="row" style="opacity:{{item.on ? 1 : 0.4}};" wx:for="{{modRows}}" wx:key="key">
        <text>{{item.name}}</text>
        <view style="display:flex;align-items:center;">
          <text class="muted" wx:if="{{!item.on}}" style="margin:0 12rpx 0 0;">已关闭</text>
          <switch checked="{{item.on}}" data-m="{{item.key}}" bindchange="onModuleToggle" color="#2FB287"/>
        </view>
      </view>
      <view class="list-note">关闭后对应内容在今日页隐藏，数据全部保留</view>
    </view>
  </view>
  <view class="card">
    <view class="card-title" style="display:flex;align-items:center;justify-content:space-between;" bindtap="toggleLog">
      <text>📒 自动日志 · 近 7 天</text>
      <text class="muted" style="margin:0;">{{logOpen ? '收起 ▴' : '展开 ▾'}}</text>
    </view>
    <view class="list-note" wx:if="{{logs.length === 0}}">暂无记录 · 去今日页打卡（三餐/补剂/运动/习惯）后自动生成</view>
    <view class="panel" wx:if="{{logOpen}}">
      <view class="row" wx:for="{{logs}}" wx:key="date">
        <view style="flex:1;min-width:0;">
          <text>{{item.weekday}} {{item.date}}</text>
          <view class="muted" style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">🍚 {{item.dinner || '未记录'}}</view>
        </view>
        <view style="display:flex;align-items:center;flex-shrink:0;">
          <text class="tag" style="margin-right:8rpx;">💊 {{item.supps}}</text>
          <text class="tag">{{item.sport}}</text>
        </view>
      </view>
    </view>
    <block wx:else>
      <view class="row" wx:if="{{logs.length}}">
        <view style="flex:1;min-width:0;">
          <text>{{logs[0].weekday}} {{logs[0].date}} · 今天</text>
          <view class="muted" style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">🍚 {{logs[0].dinner || '未记录'}}</view>
        </view>
        <view style="display:flex;align-items:center;flex-shrink:0;">
          <text class="tag" style="margin-right:8rpx;">💊 {{logs[0].supps}}</text>
          <text class="tag">{{logs[0].sport}}</text>
        </view>
      </view>
      <view class="list-note">本周运动 {{sportDays}} 天 · 点击标题展开近 7 天明细</view>
    </block>
  </view>

  <view class="card">
    <view class="card-title" style="display:flex;align-items:center;justify-content:space-between;" bindtap="togglePref">
      <text>🌙 作息与喜好</text>
      <text class="muted" style="margin:0;">{{prefOpen ? '收起 ▴' : (person.work + ' · 睡' + person.sleep + ' · ' + tasteLevels[tasteIdx] + ' ▾')}}</text>
    </view>
    <view class="panel" wx:if="{{prefOpen}}">
    <view class="row" style="align-items:center;"><text style="flex-shrink:0;">🕘 上班时间</text><input class="input time-input" value="{{person.work}}" placeholder="如 8:30 - 18:30" bindblur="onWorkBlur"/></view>
    <view class="row" style="align-items:center;"><text style="flex-shrink:0;">😴 睡觉时间</text><input class="input time-input" value="{{person.sleep}}" placeholder="如 23:00" bindblur="onSleepBlur"/></view>
    <picker range="{{tasteLevels}}" value="{{tasteIdx}}" bindchange="onTasteLevel">
      <view class="input">😋 口味：{{tasteLevels[tasteIdx]}}</view>
    </picker>
    <view class="list-note">喜欢吃的食材（自动菜单会优先排；点灰色食材添加，点已选食材或 ✕ 彻底删除）：</view>
    <view style="display:flex;flex-wrap:wrap;margin-top:8rpx;">
      <view class="fav-item" wx:for="{{favChips}}" wx:key="name">
        <view class="chip {{item.on ? 'on' : ''}}" bindtap="onFavToggle" data-v="{{item.name}}">{{item.name}}<text wx:if="{{item.on}}" class="fav-x" catchtap="onFavDel" data-v="{{item.name}}">✕</text></view>
      </view>
    </view>
    <view class="list-note">已选 {{favs.length}} 种 · {{favLast}}</view>
    <button class="btn-ghost btn-sm" hover-class="btn-hover" bindtap="clearFavs">🗑️ 清空已选食材</button>
    <view style="display:flex;margin-top:12rpx;">
      <input class="input" style="flex:1;margin:0;text-align:left;height:76rpx;line-height:76rpx;" placeholder="自定义添加食材，如：番茄" value="{{favNew}}" bindinput="onFavNew"/>
      <button class="btn-add-fav" hover-class="btn-hover" bindtap="addFav">➕ 添加</button>
    </view>
    <button class="btn-ghost btn-sm" hover-class="btn-hover" style="display:block;margin:16rpx auto 0;" bindtap="openFavTree">🌳 从分类列表选择</button>
    <tree-picker id="favtp" bind:confirm="onFavTreeConfirm" />
    <view class="list-note">修改即保存 · 清淡避开辣菜，偏辣多排辣菜</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">💡 使用建议</view>
    <view class="row" bindtap="goSuggest"><text>✍️ 提交建议</text><text class="muted" style="margin:0;">支持图片 ›</text></view>
    <view class="row" bindtap="goSuggestions"><text>📋 查看建议</text><text class="muted" style="margin:0;">使用者反馈 ›</text></view>
  </view>

  <view class="card">
    <view class="card-title">🔔 每日提醒</view>
    <view wx:if="{{remindEnabled}}" class="row">
      <text>✅ 已订阅</text>
      <text class="muted" style="margin:0;">每天 8:00 推送</text>
    </view>
    <view wx:if="{{remindEnabled}}" class="list-note">微信订阅消息为一次性：开启时务必勾选「总是保持以上选择」才会每天自动续订；若某天没收到说明额度已用完，点下方重新授权即可</view>
    <button wx:if="{{remindEnabled}}" class="btn-ghost btn-sm" hover-class="btn-hover" bindtap="openRemind">重新授权</button>
    <block wx:else>
      <button class="btn-ghost" style="min-width:0;padding:14rpx 32rpx;" hover-class="btn-hover" bindtap="openRemind">🔔 开启每日提醒</button>
      <view class="list-note">授权时勾选「总是保持以上选择」才能每天收到</view>
    </block>
  </view>
  <view class="card">
    <view class="card-title" style="display:flex;align-items:center;justify-content:space-between;" bindtap="showAbout" hover-class="row-hover">
      <text>ℹ️ 关于欢洋生活</text>
      <text class="muted" style="margin:0;">v{{version}} ›</text>
    </view>
    <view class="row" bindtap="openPrivacy" hover-class="row-hover"><text>🔒 用户隐私保护指引</text><text class="muted" style="margin:0;">›</text></view>
    <button class="btn-danger" hover-class="btn-hover" bindtap="logout">退出登录</button>
    <view class="list-note" style="text-align:center;">退出将清空本机数据（云端保留，重新登录自动恢复）</view>
  </view>
  </block>
</view>