/* 掌中决 · 扩展页共用样式 */

.ext-hero {
  background: linear-gradient(135deg, #6C7BD8 0%, #4A5AB8 100%);
  border-radius: 32rpx; padding: 40rpx 32rpx; color: #FFF; margin-bottom: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(74,90,184,0.25);
}
.ext-hero .t { font-size: 44rpx; font-weight: 800; letter-spacing: 3rpx; }
.ext-hero .s { font-size: 25rpx; opacity: 0.9; margin-top: 10rpx; }

.ext-card { background: #FFF; border-radius: 28rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 6rpx 24rpx rgba(47,178,135,0.07); }
.ext-label { font-size: 24rpx; color: #7A8B82; font-weight: 600; margin-bottom: 12rpx; letter-spacing: 1rpx; }
.ext-kv { display: flex; padding: 14rpx 0; border-bottom: 1rpx solid #F0F6F3; }
.ext-kv:last-child { border-bottom: none; }
.ext-k { width: 130rpx; flex-shrink: 0; font-size: 26rpx; color: #7A8B82; }
.ext-v { flex: 1; font-size: 28rpx; font-weight: 600; color: #22322B; }
.ext-alt { font-size: 22rpx; color: #9AA8A2; font-weight: 400; }
.ext-verse { font-size: 27rpx; line-height: 1.8; color: #4A5AB8; font-weight: 600; }
.ext-read { font-size: 27rpx; line-height: 1.8; color: #22322B; }

.ext-stage { display: flex; padding: 22rpx 0; border-bottom: 1rpx solid #F0F6F3; }
.ext-stage:last-child { border-bottom: none; }
.ext-stage-no {
  width: 64rpx; height: 64rpx; line-height: 64rpx; text-align: center; flex-shrink: 0;
  background: #EEF0FC; color: #4A5AB8; border-radius: 20rpx;
  font-size: 30rpx; font-weight: 800; margin-right: 18rpx;
}
.ext-stage-body { flex: 1; }
.ext-stage-head { font-size: 28rpx; font-weight: 700; color: #4A5AB8; }
.ext-stage-text { font-size: 26rpx; line-height: 1.7; color: #22322B; margin-top: 8rpx; }

.ext-warn {
  font-size: 22rpx; color: #C97B0E; background: #FFF7E8; border-radius: 16rpx;
  padding: 18rpx 22rpx; line-height: 1.7; margin-top: 8rpx;
}
.ext-input {
  border: 2rpx solid #E4EFEA; border-radius: 18rpx; padding: 18rpx 22rpx;
  background: #FAFDFB; font-size: 28rpx; margin-bottom: 8rpx;
}
.ext-grid { display: flex; flex-wrap: wrap; width: 100%; }
.ext-cell { width: 33.333%; padding: 10rpx; box-sizing: border-box; }
.ext-dot { border-radius: 20rpx; padding: 18rpx 6rpx; text-align: center; background: #FFF; border: 3rpx solid #E4EFEA; transition: all .12s ease-out; }
.ext-dot.on { background: linear-gradient(135deg, #6C7BD8 0%, #4A5AB8 100%); border-color: #3A48A0; transform: scale(1.08); box-shadow: 0 8rpx 20rpx rgba(74,90,184,0.4); }
.ext-dot .tt { font-size: 32rpx; font-weight: 800; color: #22322B; line-height: 1.1; }
.ext-dot .tr { font-size: 19rpx; color: #7A8B82; margin-top: 3rpx; }
.ext-dot.on .tt, .ext-dot.on .tr { color: #FFF; }

/* ── 互动解读：关注点选择 ── */
.ext-focus {
  border: 2rpx solid #E4EFEA; border-radius: 20rpx; padding: 22rpx 24rpx;
  margin-bottom: 16rpx; background: #FAFDFB;
}
.ext-focus:last-child { margin-bottom: 0; }
.ext-focus-t { font-size: 30rpx; font-weight: 700; color: #22322B; }
.ext-focus-h { font-size: 24rpx; color: #7A8B82; margin-top: 6rpx; }

/* ── 互动解读：逐层展开 ── */
.ext-stage-hint {
  font-size: 25rpx; line-height: 1.7; color: #4A5AB8; margin-top: 10rpx;
  padding-left: 16rpx; border-left: 6rpx solid #DDE2F7;
}
.ext-stage-more { font-size: 24rpx; color: #9AA8A2; margin-top: 8rpx; }
.ext-more {
  text-align: center; font-size: 26rpx; color: #4A5AB8; font-weight: 600;
  padding: 20rpx 0 6rpx; border-top: 1rpx solid #F0F6F3; margin-top: 8rpx;
}

/* ── 互动解读：行动清单 / 追问 ── */
.ext-act { display: flex; font-size: 27rpx; line-height: 1.75; color: #22322B; padding: 10rpx 0; }
.ext-act-no {
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; flex-shrink: 0;
  background: #EEF0FC; color: #4A5AB8; border-radius: 50%; font-size: 24rpx; font-weight: 700;
  margin: 4rpx 14rpx 0 0;
}
.ext-closing {
  margin-top: 16rpx; padding: 18rpx 22rpx; border-radius: 16rpx;
  background: #F2F4FE; color: #3A48A0; font-size: 26rpx; line-height: 1.7; font-weight: 600;
}
.ext-fu { padding: 20rpx 0; border-bottom: 1rpx solid #F0F6F3; }
.ext-fu:last-child { border-bottom: none; }
.ext-fu-q { font-size: 27rpx; font-weight: 600; color: #4A5AB8; }
.ext-fu-q::after { content: ' ›'; color: #9AA8A2; }
.ext-fu-a { font-size: 26rpx; line-height: 1.75; color: #22322B; margin-top: 10rpx; }

/* ── 隐私提示 / AI 状态标注 ── */
.ext-note { font-size: 22rpx; color: #8AA39A; line-height: 1.7; margin-top: 10rpx; }
.ext-ai {
  display: flex; align-items: center; flex-wrap: wrap;
  background: #F2F4FE; border-radius: 16rpx; padding: 16rpx 20rpx; margin-bottom: 16rpx;
}
.ext-ai-tag {
  font-size: 22rpx; font-weight: 700; color: #4A5AB8;
  background: #FFF; border-radius: 10rpx; padding: 4rpx 12rpx; margin-right: 12rpx;
}
.ext-ai-note { font-size: 22rpx; color: #6C7BD8; line-height: 1.6; flex: 1; min-width: 200rpx; }
