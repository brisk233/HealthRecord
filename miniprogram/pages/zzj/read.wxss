/* 掌中决 · 白话互动解读 · 共用样式
   被 zzj.wxss（核心层）与 lost.wxss（扩展层）共同 @import。
   本文件属核心层，上架构建保留。 */

/* 你选的是 */
.pick-chip { text-align: center; font-size: 25rpx; color: var(--sub); margin-bottom: 18rpx; }
.pick-strong { font-size: 30rpx; font-weight: 800; color: var(--brand-deep); }

/* 关注点 chips */
.chip-wrap { display: flex; flex-wrap: wrap; }
.chip {
  padding: 14rpx 26rpx; margin: 0 14rpx 14rpx 0; border-radius: 999rpx;
  background: #F4FAF7; border: 2rpx solid #E4EFEA; font-size: 26rpx; color: var(--text);
}
.chip:active { transform: scale(0.96); }
.chip.on { background: var(--brand-soft); border-color: var(--brand); color: var(--brand-deep); font-weight: 700; }

/* 白话结论打头 */
.res-headline {
  background: var(--grad); color: #FFF; border-radius: 28rpx;
  padding: 34rpx 30rpx; margin-bottom: 24rpx; font-size: 33rpx; line-height: 1.6; font-weight: 700;
  box-shadow: 0 10rpx 30rpx rgba(47,178,135,0.22);
}

/* 分层展开 */
.layer { border-bottom: 1rpx solid #F0F6F3; }
.layer:last-of-type { border-bottom: none; }
.layer-head { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; }
.layer-t { font-size: 29rpx; font-weight: 700; color: var(--text); }
.layer-arrow { font-size: 24rpx; color: var(--sub); }
.layer-x { font-size: 27rpx; line-height: 1.8; color: #4A5A52; padding: 0 0 22rpx; }

/* 今天/现在做一件事 */
.sec-label { font-size: 24rpx; color: var(--sub); font-weight: 600; margin-bottom: 14rpx; letter-spacing: 1rpx; }
.close-card { background: #FFFDF6; border: 2rpx solid #FFE9B8; }
.close-text { font-size: 30rpx; line-height: 1.7; font-weight: 700; color: #8A6A16; }

/* 追问 */
.fq { border-bottom: 1rpx solid #F0F6F3; }
.fq:last-child { border-bottom: none; }
.fq-q { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; }
.fq-qt { flex: 1; font-size: 27rpx; color: var(--brand-deep); font-weight: 600; margin-right: 12rpx; }
.fq-a { font-size: 26rpx; line-height: 1.8; color: #4A5A52; padding: 0 0 20rpx; }

/* 传统依据（默认收起）*/
.trad-box { margin-top: 18rpx; padding: 22rpx; background: #F8FAF9; border-radius: 18rpx; }
.trad-name { font-size: 32rpx; font-weight: 800; color: var(--brand-deep); }
.trad-tagline { font-size: 25rpx; color: var(--text); margin-top: 8rpx; }
.trad-sub { font-size: 23rpx; color: var(--sub); margin-top: 6rpx; }
.trad-verse { font-size: 27rpx; line-height: 1.8; color: var(--brand-deep); font-weight: 600; margin-top: 12rpx; }
.trad-note { font-size: 22rpx; color: var(--sub); margin-top: 14rpx; line-height: 1.6; }
