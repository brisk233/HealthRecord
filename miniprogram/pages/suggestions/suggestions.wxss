.suggest-text-view { font-size: 28rpx; line-height: 1.6; color: var(--text); padding: 12rpx 0; }
.img-grid { display: flex; flex-wrap: wrap; }
.img-item { width: 200rpx; height: 200rpx; margin: 0 16rpx 16rpx 0; border-radius: 16rpx; overflow: hidden; background: #F0F6F3; }
.img-item image { width: 100%; height: 100%; }
