.suggest-text { width: 100%; box-sizing: border-box; min-height: 200rpx; border: 2rpx solid #E4EFEA; border-radius: 18rpx; padding: 16rpx 20rpx; background: #FAFDFB; font-size: 28rpx; line-height: 1.6; margin-bottom: 16rpx; }
.img-grid { display: flex; flex-wrap: wrap; }
.img-item { position: relative; width: 200rpx; height: 200rpx; margin: 0 16rpx 16rpx 0; border-radius: 16rpx; overflow: hidden; background: #F0F6F3; }
.img-item image { width: 100%; height: 100%; }
.img-del { position: absolute; top: 8rpx; right: 8rpx; width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; background: rgba(0,0,0,0.55); color: #FFF; border-radius: 50%; font-size: 24rpx; }
.img-add { width: 200rpx; height: 200rpx; border: 2rpx dashed #C9DED5; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 56rpx; color: #8AA39A; background: #FAFDFB; margin-bottom: 16rpx; }
