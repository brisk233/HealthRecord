<privacy-popup id="pp" />
<view class="page">
  <view class="card">
    <view class="card-title">💡 小程序使用建议</view>
    <view class="list-note">说说哪里不好用、想要什么功能，我会认真看（最多 3 张图片）</view>
    <textarea class="suggest-text" placeholder="写下你的建议…" value="{{text}}" bindinput="onText" maxlength="500"/>
    <view class="img-grid">
      <view class="img-item" wx:for="{{images}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" data-idx="{{index}}" bindtap="previewImage"/>
        <view class="img-del" data-idx="{{index}}" catchtap="removeImage">✕</view>
      </view>
      <view class="img-add" wx:if="{{images.length < 3}}" bindtap="pickImage">➕</view>
    </view>
    <button class="btn-primary" hover-class="btn-hover" bindtap="submit" disabled="{{submitting}}">提交建议</button>
  </view>
</view>
