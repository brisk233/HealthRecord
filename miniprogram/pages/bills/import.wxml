<privacy-popup id="pp" />
<view class="page">
  <view class="card" wx:if="{{candidates.length === 0 && !importing}}">
    <view class="empty"><text class="emoji">📷</text>从微信账单截图导入<view class="muted">微信「我 → 服务 → 钱包 → 账单」截几张含金额的图，自动识别商户/金额/日期，你只需选用途</view></view>
    <button class="btn-primary" hover-class="btn-hover" bindtap="pickImages">🖼️ 选择账单截图（最多5张）</button>
    <view class="list-note" style="text-align:center;">首次使用需在腾讯云开通「文字识别」并在 family 云函数配置密钥（见 README）</view>
  </view>

  <view class="card" wx:if="{{importing}}">
    <view class="empty"><text class="emoji">🤖</text>{{importingStep}}</view>
  </view>

  <view class="card" wx:if="{{candidates.length > 0 && !importing}}">
    <view class="card-title">🔍 识别到 {{cntTotal}} 笔（点金额右侧勾选/取消）</view>
    <view class="row" wx:for="{{candidates}}" wx:key="_k" wx:for-item="c">
      <view style="flex:1;min-width:0;">
        <text>{{c.type === 'income' ? '📥' : '💸'}} {{c.merchant}}</text>
        <view class="muted">¥{{c.amount}} <text wx:if="{{c.date}}">· {{c.date}}</text><text wx:else>· (今天)</text></view>
        <view style="display:flex;flex-wrap:wrap;margin-top:6rpx;">
          <text class="chip {{c.category==='food'?'on':''}}" style="font-size:22rpx;padding:6rpx 18rpx;margin:0 8rpx 8rpx 0;" bindtap="pickCat" data-k="{{c._k}}" data-v="food">🍚 餐饮</text>
          <text class="chip {{c.category==='market'?'on':''}}" style="font-size:22rpx;padding:6rpx 18rpx;margin:0 8rpx 8rpx 0;" bindtap="pickCat" data-k="{{c._k}}" data-v="market">🥬 食材</text>
          <text class="chip {{c.category==='transport'?'on':''}}" style="font-size:22rpx;padding:6rpx 18rpx;margin:0 8rpx 8rpx 0;" bindtap="pickCat" data-k="{{c._k}}" data-v="transport">🚌 交通</text>
          <text class="chip {{c.category==='daily'?'on':''}}" style="font-size:22rpx;padding:6rpx 18rpx;margin:0 8rpx 8rpx 0;" bindtap="pickCat" data-k="{{c._k}}" data-v="daily">🧻 日用</text>
          <text class="chip {{c.category==='other'?'on':''}}" style="font-size:22rpx;padding:6rpx 18rpx;margin:0 8rpx 8rpx 0;" bindtap="pickCat" data-k="{{c._k}}" data-v="other">📦 其他</text>
          <text class="chip {{c.person==='male'?'on':''}}" style="font-size:22rpx;padding:6rpx 18rpx;margin:0 8rpx 8rpx 0;" bindtap="pickPerson" data-k="{{c._k}}" data-v="male">👦 他</text>
          <text class="chip {{c.person==='female'?'on':''}}" style="font-size:22rpx;padding:6rpx 18rpx;margin:0 8rpx 8rpx 0;" bindtap="pickPerson" data-k="{{c._k}}" data-v="female">👧 她</text>
        </view>
      </view>
      <view class="cb {{c.picked ? 'on' : ''}}" bindtap="togglePick" data-k="{{c._k}}">{{c.picked ? '✓' : ''}}</view>
    </view>
    <button class="btn-primary" hover-class="btn-hover" bindtap="saveAll">✅ 保存勾选 {{cntOk}} 笔</button>
  </view>

  <view class="card" wx:if="{{done}}">
    <view class="empty"><text class="emoji">🎉</text>已导入 {{cntOk}} 笔</view>
  </view>
</view>