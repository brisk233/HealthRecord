.tp-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 9999; display: flex; align-items: flex-end; }
.tp-body { width: 100%; background: #FFF; border-radius: 32rpx 32rpx 0 0; padding: 24rpx 0 0; box-sizing: border-box; max-height: 78vh; display: flex; flex-direction: column; }
.tp-head { display: flex; align-items: center; justify-content: space-between; padding: 0 28rpx 12rpx; }
.tp-title { font-size: 32rpx; font-weight: 700; }
.tp-close { width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center; background: #F0F6F3; color: #5A6B62; border-radius: 50%; font-size: 26rpx; }

/* 大类横向 tab */
.tp-tabs { width: 100%; white-space: nowrap; background: #F7FBF9; }
.tp-tabs-inner { display: inline-flex; padding: 8rpx 20rpx 12rpx; }
.tp-tab { padding: 12rpx 30rpx; border-radius: 999rpx; background: #EFF6F2; color: #5A6B62; font-size: 26rpx; font-weight: 600; margin-right: 14rpx; }
.tp-tab.on { background: var(--grad); color: #FFF; box-shadow: 0 4rpx 12rpx rgba(47,178,135,0.25); }

/* 子类分组 + 食材平铺 */
.tp-list { flex: 1; min-height: 320rpx; overflow-y: auto; padding: 8rpx 28rpx 0; box-sizing: border-box; }
.tp-group { font-size: 24rpx; color: var(--sub); font-weight: 600; margin: 18rpx 0 10rpx; }
.tp-items { display: flex; flex-wrap: wrap; }
.tp-leaf { padding: 12rpx 28rpx; margin: 0 12rpx 12rpx 0; border-radius: 999rpx; background: #EFF6F2; color: #5A6B62; font-size: 26rpx; font-weight: 600; }
.tp-leaf.on { background: var(--grad); color: #FFF; box-shadow: 0 4rpx 12rpx rgba(47,178,135,0.28); }
.tp-leaf-check { margin-left: 8rpx; }

/* 底部已选区 + 确认 */
.tp-foot { border-top: 1rpx solid #F0F6F3; padding: 16rpx 28rpx calc(env(safe-area-inset-bottom) + 20rpx); background: #FFF; }
.tp-foot-info { min-height: 44rpx; margin-bottom: 12rpx; }
.tp-foot-empty { font-size: 24rpx; color: #B9C7C0; }
.tp-chosen { display: flex; flex-wrap: wrap; }
.tp-chosen-tag { padding: 6rpx 18rpx; margin: 0 10rpx 8rpx 0; border-radius: 999rpx; background: var(--brand-soft); color: var(--brand-deep); font-size: 24rpx; font-weight: 600; }
.tp-chosen-x { margin-left: 10rpx; color: var(--danger); font-size: 22rpx; }
.tp-done { width: 100% !important; margin: 0 !important; background: var(--grad); color: #FFF; border: none; border-radius: 16rpx; padding: 18rpx 0 !important; font-size: 28rpx; font-weight: 700; }
.tp-done[disabled] { opacity: 0.5; }