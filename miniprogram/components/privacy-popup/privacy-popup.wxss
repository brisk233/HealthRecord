.pp-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 9999; display: flex; align-items: center; justify-content: center; }
.pp-box { width: 600rpx; background: #FFF; border-radius: 28rpx; padding: 40rpx 36rpx; box-sizing: border-box; }
.pp-title { font-size: 34rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.pp-content { font-size: 26rpx; color: #5A6B62; line-height: 1.7; }
.pp-link { display: inline; background: none; border: none; padding: 0; margin: 0 4rpx; color: #2FB287; font-size: 26rpx; line-height: 1.7; }
.pp-link::after { border: none; }
.pp-btns { display: flex; margin-top: 32rpx; }
.pp-btn { flex: 1; border-radius: 999rpx; font-size: 28rpx; padding: 16rpx 0; line-height: 1.5; }
.pp-refuse { background: #F0F3F1; color: #5A6B62; margin-right: 16rpx; }
.pp-agree { background: linear-gradient(135deg, #5FD8AC 0%, #2FB287 100%); color: #FFF; }
